# --- required in production
DATABASE_URL=postgres://merepoints:CHANGE_ME@your-rds-endpoint:5432/merepoints?sslmode=require
JWT_SECRET=long-random-string-64-chars
QR_SECRET=another-long-random-string
OTP_SECRET=another-long-random-string
NODE_ENV=production
# Web dashboard address(es) allowed to call the API
CORS_ORIGINS=https://app.merepoints.in

# --- first deploy only: creates the first Super Admin owner if none exists
ADMIN_BOOTSTRAP_USERNAME=mohit
ADMIN_BOOTSTRAP_NAME=Mohit Sharma
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-first-login-123

# --- Razorpay (leave empty for test mode; test mode is refused when NODE_ENV=production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- photo uploads (product photos, ad banners): S3 bucket served through CloudFront
S3_BUCKET=merepoints-uploads-CHANGE_ME
AWS_REGION=ap-south-1
S3_PUBLIC_BASE_URL=https://files.merepoints.in
# The API's own public address (used for upload links in development without S3)
PUBLIC_API_URL=https://api.merepoints.in/v1

# --- optional
RUN_JOBS=true
PORT=8080

# Google sign-in: OAuth client IDs (web + Android + iOS), comma separated. Leave empty to keep Google off.
GOOGLE_CLIENT_IDS=

# Phone push (Firebase > Project settings > Service accounts > Generate key). Paste the whole JSON on one line.
FCM_SERVICE_ACCOUNT_JSON=
NOTIFICATIONS_PER_DAY=5
