# --- required in production
DATABASE_URL=postgres://vyapar:CHANGE_ME@your-rds-endpoint:5432/vyapar?sslmode=require
JWT_SECRET=long-random-string-64-chars
QR_SECRET=another-long-random-string
OTP_SECRET=another-long-random-string
NODE_ENV=production
# Web dashboard address(es) allowed to call the API
CORS_ORIGINS=https://app.vyaparpoint.in

# --- first deploy only: creates the first Super Admin owner if none exists
ADMIN_BOOTSTRAP_USERNAME=mohit
ADMIN_BOOTSTRAP_NAME=Mohit Sharma
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-first-login-123

# --- Razorpay (leave empty for test mode; test mode is refused when NODE_ENV=production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- optional
RUN_JOBS=true
PORT=8080
